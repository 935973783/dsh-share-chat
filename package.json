{
  "name": "dsh-share-chat",
  "version": "0.10.2",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "chat",
    "social",
    "share",
    "snapshot",
    "minigame",
    "meeting",
    "camp"
  ],
  "description": "Social chat, calls, camps and shared session snapshots inside the DSH conversation view.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/laughing-faith/dsh-share-chat.git"
  },
  "homepage": "https://gitee.com/laughing-faith/dsh-share-chat#readme"
}